{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "checkJs": true,
    "allowJs": true,
    "strict": true,
    "noEmit": true,
    "jsx": "preserve",
    "types": ["node"],
    "paths": { "@/*": ["./*"] }
  },
  "exclude": ["node_modules", ".next", ".claude"]
}
