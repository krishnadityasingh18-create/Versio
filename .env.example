# Copy to .env.local and fill in. Never commit .env.local.

# Supabase (public: safe in the browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# App origin for auth redirects (e.g. http://localhost:3000); required in production
NEXT_PUBLIC_SITE_URL=

# Supabase (server only: never prefix with NEXT_PUBLIC_)
SUPABASE_SERVICE_ROLE_KEY=

# Cloudflare R2 (server only)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# S3-compatible object storage (server only). Supabase Storage S3 endpoint tonight, R2 later.
# Supabase: S3_ENDPOINT=https://<ref>.storage.supabase.co/storage/v1/s3  S3_REGION=<project region>
# R2:       S3_ENDPOINT=https://<account>.r2.cloudflarestorage.com       S3_REGION=auto
S3_ENDPOINT=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_BUCKET=
# "true" when the store enforces signed x-amz-checksum-sha256 (R2); otherwise the server re-hashes staged bytes.
S3_VERIFIES_CHECKSUM=false
